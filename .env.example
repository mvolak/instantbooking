# Server-side only. Never prefix with NEXT_PUBLIC_ — it contains database credentials.
#
# Local Supabase (`npm run db:start`) — default credentials printed by `supabase status`:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
#
# Hosted Supabase: Project → Connect → "Transaction pooler" connection string, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: maximum connections in the server's pool (default 10).
# DATABASE_POOL_MAX=10

# Tests only: database used by `npm test` (defaults to DATABASE_URL, then local Supabase).
# Integration tests create and delete their own fixtures; never point this at production.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
